# GeoMind Location Intelligence API — environment configuration
# Copy to `.env` and adjust as needed. All variables use the GEOMIND_ prefix.

# Async SQLAlchemy URL (asyncpg driver). For docker-compose the host is `db`.
GEOMIND_DATABASE_URL=postgresql+asyncpg://geomind:geomind@localhost:5432/geomind

# HTTP behaviour
GEOMIND_HTTP_TIMEOUT_S=30
GEOMIND_USER_AGENT=GeoMind/0.1 (+https://github.com/VarunGore36/GeoMind)

# Overpass (OpenStreetMap). Endpoints are tried in order with backoff.
GEOMIND_OVERPASS_ENDPOINTS=["https://overpass-api.de/api/interpreter","https://maps.mail.ru/osm/tools/overpass/api/interpreter","https://overpass.kumi.systems/api/interpreter"]
GEOMIND_OVERPASS_TIMEOUT_S=25
GEOMIND_OVERPASS_MAX_RETRIES=2

# Elevation provider (OpenTopoData primary, Open-Elevation fallback)
GEOMIND_ELEVATION_ENDPOINT=https://api.opentopodata.org/v1/srtm30m
GEOMIND_ELEVATION_FALLBACK_ENDPOINT=https://api.open-elevation.com/api/v1/lookup
GEOMIND_ELEVATION_SAMPLES=5

# Query limits
GEOMIND_MIN_RADIUS_M=10
GEOMIND_MAX_RADIUS_M=5000
GEOMIND_DEFAULT_RADIUS_M=500
GEOMIND_WATER_SEARCH_BUFFER_M=2000

# Caching of ingested OSM coverage, in seconds (default 24h)
GEOMIND_CACHE_TTL_S=86400
